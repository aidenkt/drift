// Base44 hosts the web app and sharing: the Workbook entity (entities/), the `workbooks`
// function (functions/) and the WorkbookRoom presence actor (actors/). Sign-in is Clerk, so the
// Base44 app itself is public; the function checks Clerk sessions (secrets: CLERK_PUBLISHABLE_KEY,
// CLERK_SECRET_KEY). Deploy with `npx base44 deploy`.
// Lives at the repo root so Base44's GitHub integration finds it; the site is built from web/.
{
  "name": "since",
  "description": "Catch stale assumptions in financial models",
  "visibility": "public",
  "site": {
    "buildCommand": "cd web && npm ci && npm run build",
    "outputDirectory": "./web/dist"
  }
}
